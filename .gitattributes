# ==============================================================================
# ARC Stick-Fighter .gitattributes
# Ensure consistent line endings across Windows and other machines
# ==============================================================================

# Auto-detect text files and normalize line endings
* text=auto

# Web & Source Files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Configuration Files
.gitignore text eol=lf
.gitattributes text eol=lf
