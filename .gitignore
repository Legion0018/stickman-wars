# ==============================================================================
# ARC Stick-Fighter .gitignore
# ==============================================================================

# Python Virtual Environments & Caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Sensitive Files
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
credentials.json

# Operating System Specific
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor & IDE Directories
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs, Scratch & Temporary Directories
*.log
tmp/
temp/
scratch/
